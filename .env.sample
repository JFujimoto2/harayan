# Slack Webhook URL for contact form notifications
# Get from: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/XXXXX/XXXXX

# Google Sheets API
# Spreadsheet ID from URL: https://docs.google.com/spreadsheets/d/【THIS_ID】/edit
GOOGLE_SHEETS_SPREADSHEET_ID=XXXXX

# Google credentials file path (development)
GOOGLE_SHEETS_CREDENTIALS=config/google_credentials.json

# Google credentials JSON (production - Base64 encoded)
# Generate with: base64 -w 0 config/google_credentials.json
# GOOGLE_SHEETS_CREDENTIALS_JSON=XXXXX
