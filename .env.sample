# ============================================
# Development Environment (.env)
# ============================================

# Slack Webhook URL for contact form notifications
# Get from: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/XXXXX/XXXXX

# Google Sheets API
# Spreadsheet ID from URL: https://docs.google.com/spreadsheets/d/【THIS_ID】/edit
GOOGLE_SHEETS_SPREADSHEET_ID=XXXXX

# Google credentials file path (development only)
GOOGLE_SHEETS_CREDENTIALS=config/google_credentials.json

# ============================================
# Production Environment (Render Dashboard)
# ============================================
# Set these in Render Dashboard → Environment, NOT in .env file
#
# RAILS_ENV=production
# RAILS_SERVE_STATIC_FILES=true
#
# SECRET_KEY_BASE=<generate with: bin/rails secret>
# ⚠️  NEVER commit the actual SECRET_KEY_BASE to git!
#
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/XXXXX/XXXXX
# GOOGLE_SHEETS_SPREADSHEET_ID=XXXXX
# GOOGLE_SHEETS_CREDENTIALS_JSON=<generate with: base64 -w 0 config/google_credentials.json>
