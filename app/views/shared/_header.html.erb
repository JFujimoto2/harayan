<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-200 transition-all" data-controller="mobile-menu">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex justify-between items-center h-16">
      <%# Logo %>
      <%= link_to root_path, class: "text-xl font-semibold text-gray-900 hover:text-gray-600 transition-colors" do %>
        Harayan
      <% end %>

      <%# Desktop Navigation %>
      <nav class="hidden md:flex items-center gap-8">
        <%= link_to "About", about_path, class: "nav-link" %>
        <%= link_to "Stores", stores_path, class: "nav-link" %>
        <%= link_to "Business", business_path, class: "nav-link" %>
        <%= link_to "Recruit", recruit_path, class: "nav-link" %>
        <%= link_to "Contact", contact_path, class: "nav-link" %>
      </nav>

      <%# Mobile Menu Button %>
      <button type="button" class="md:hidden p-2 text-gray-600 hover:text-gray-900 transition-colors" data-action="click->mobile-menu#toggle">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <%# Mobile Navigation (hidden by default) %>
  <div class="md:hidden hidden" data-mobile-menu-target="menu">
    <nav class="px-6 py-4 space-y-2 bg-white border-t border-gray-100">
      <%= link_to "About", about_path, class: "block py-2 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
      <%= link_to "Stores", stores_path, class: "block py-2 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
      <%= link_to "Business", business_path, class: "block py-2 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
      <%= link_to "Recruit", recruit_path, class: "block py-2 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
      <%= link_to "Contact", contact_path, class: "block py-2 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
    </nav>
  </div>
</header>

<%# Spacer for fixed header %>
<div class="h-16"></div>
