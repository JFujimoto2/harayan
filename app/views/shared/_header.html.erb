<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100" data-controller="mobile-menu">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <%# Logo %>
      <%= link_to root_path, class: "text-2xl font-semibold tracking-wide text-primary-600 hover:text-primary-700 transition-colors" do %>
        Harayan
      <% end %>

      <%# Desktop Navigation %>
      <nav class="hidden md:flex items-center gap-8">
        <%= link_to "About", about_path, class: "text-sm font-medium tracking-wider uppercase text-gray-600 hover:text-primary-600 transition-colors" %>
        <%= link_to "Shops", shops_path, class: "text-sm font-medium tracking-wider uppercase text-gray-600 hover:text-primary-600 transition-colors" %>
        <%= link_to "Recruit", recruit_path, class: "text-sm font-medium tracking-wider uppercase text-gray-600 hover:text-primary-600 transition-colors" %>
        <%= link_to "Contact", contact_path, class: "text-sm font-medium tracking-wider uppercase text-gray-600 hover:text-primary-600 transition-colors" %>
      </nav>

      <%# Mobile Menu Button %>
      <button type="button" class="md:hidden p-2 text-gray-600 hover:text-primary-600" data-action="click->mobile-menu#toggle">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <%# Mobile Navigation (hidden by default) %>
  <div class="md:hidden hidden" data-mobile-menu-target="menu">
    <nav class="px-4 py-4 space-y-2 bg-white border-t border-gray-100">
      <%= link_to "About", about_path, class: "block py-2 text-sm font-medium text-gray-600 hover:text-primary-600" %>
      <%= link_to "Shops", shops_path, class: "block py-2 text-sm font-medium text-gray-600 hover:text-primary-600" %>
      <%= link_to "Recruit", recruit_path, class: "block py-2 text-sm font-medium text-gray-600 hover:text-primary-600" %>
      <%= link_to "Contact", contact_path, class: "block py-2 text-sm font-medium text-gray-600 hover:text-primary-600" %>
    </nav>
  </div>
</header>

<%# Spacer for fixed header %>
<div class="h-20"></div>
