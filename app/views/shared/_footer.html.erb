<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <%# Brand %>
      <div class="md:col-span-2">
        <h3 class="text-2xl font-semibold tracking-wide mb-4">Harayan</h3>
        <p class="text-gray-400 text-sm leading-relaxed max-w-md">
          <%# ここに会社のキャッチコピーや説明文を入れる %>
          お客様に最高の体験をお届けします。
        </p>
      </div>

      <%# Navigation %>
      <div>
        <h4 class="text-sm font-semibold tracking-wider uppercase mb-4">Menu</h4>
        <nav class="space-y-2">
          <%= link_to "About", about_path, class: "block text-sm text-gray-400 hover:text-white transition-colors" %>
          <%= link_to "Shops", shops_path, class: "block text-sm text-gray-400 hover:text-white transition-colors" %>
          <%= link_to "Recruit", recruit_path, class: "block text-sm text-gray-400 hover:text-white transition-colors" %>
          <%= link_to "Contact", contact_path, class: "block text-sm text-gray-400 hover:text-white transition-colors" %>
        </nav>
      </div>

      <%# Contact Info %>
      <div>
        <h4 class="text-sm font-semibold tracking-wider uppercase mb-4">Contact</h4>
        <div class="space-y-2 text-sm text-gray-400">
          <p>〒000-0000</p>
          <p>東京都○○区○○ 1-2-3</p>
          <p>TEL: 03-0000-0000</p>
        </div>
      </div>
    </div>

    <%# Copyright %>
    <div class="mt-12 pt-8 border-t border-gray-800">
      <p class="text-center text-sm text-gray-500">
        &copy; <%= Time.current.year %> Harayan. All rights reserved.
      </p>
    </div>
  </div>
</footer>
