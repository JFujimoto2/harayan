<footer class="bg-gray-50 border-t border-gray-200">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <%# Brand %>
      <div class="md:col-span-2">
        <h3 class="text-xl font-semibold text-gray-900 mb-4">Harayan</h3>
        <p class="text-gray-500 text-sm leading-relaxed max-w-md">
          お客様に寄り添い、最高の体験をお届けします。<br>
          心地よい空間と丁寧なサービスで、特別な時間を。
        </p>
      </div>

      <%# Navigation %>
      <div>
        <h4 class="text-sm font-semibold text-gray-900 mb-4">Menu</h4>
        <nav class="space-y-2">
          <%= link_to "About", about_path, class: "block text-sm text-gray-500 hover:text-gray-900 transition-colors" %>
          <%= link_to "Shops", shops_path, class: "block text-sm text-gray-500 hover:text-gray-900 transition-colors" %>
          <%= link_to "Recruit", recruit_path, class: "block text-sm text-gray-500 hover:text-gray-900 transition-colors" %>
          <%= link_to "Contact", contact_path, class: "block text-sm text-gray-500 hover:text-gray-900 transition-colors" %>
        </nav>
      </div>

      <%# Contact Info %>
      <div>
        <h4 class="text-sm font-semibold text-gray-900 mb-4">Contact</h4>
        <div class="space-y-2 text-sm text-gray-500">
          <p>〒000-0000</p>
          <p>東京都○○区○○ 1-2-3</p>
          <p>TEL: 03-0000-0000</p>
        </div>
      </div>
    </div>

    <%# Copyright %>
    <div class="mt-12 pt-8 border-t border-gray-200">
      <p class="text-center text-sm text-gray-400">
        &copy; <%= Time.current.year %> Harayan. All rights reserved.
      </p>
    </div>
  </div>
</footer>
