<% content_for(:title) { "Contact | Harayan" } %>

<%# ページヘッダー %>
<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl md:text-5xl font-light tracking-wide text-gray-900 mb-4">
      Contact
    </h1>
    <p class="text-gray-600">
      お問い合わせ
    </p>
  </div>
</section>

<%# お問い合わせ案内 %>
<section class="py-12 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-gray-600 mb-4">
      ご質問・ご相談など、お気軽にお問い合わせください。
    </p>
    <p class="text-gray-500 text-sm">
      通常、3営業日以内にご返信いたします。
    </p>
  </div>
</section>

<%# お問い合わせフォーム %>
<section class="py-12 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gray-50 p-4 md:p-8">
      <%# タイトル部分を隠すためのラッパー %>
      <div class="overflow-hidden">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSdxImtaSbXv3l9g8r5JwRhdpEOKlLuzZU4rOkitlHV1VFSuuA/viewform?embedded=true"
          width="100%"
          height="1100"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          class="w-full -mt-14">
          読み込んでいます...
        </iframe>
      </div>
    </div>
  </div>
</section>

<%# その他の連絡先 %>
<section class="py-20 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-light tracking-wide text-gray-900 mb-12 text-center">
      その他のお問い合わせ方法
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <%# 電話 %>
      <div class="bg-white p-8 text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-primary-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">お電話</h3>
        <p class="text-2xl text-primary-600 font-medium mb-2">03-0000-0000</p>
        <p class="text-gray-500 text-sm">
          営業時間: 10:00 - 20:00<br>
          （水曜定休）
        </p>
      </div>

      <%# メール %>
      <div class="bg-white p-8 text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-primary-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">メール</h3>
        <p class="text-xl text-primary-600 font-medium mb-2">info@harayan.example.com</p>
        <p class="text-gray-500 text-sm">
          24時間受付<br>
          （返信は営業時間内）
        </p>
      </div>
    </div>
  </div>
</section>
