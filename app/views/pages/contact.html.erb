<% content_for(:title) { "Contact | Harayan" } %>

<%# ページヘッダー %>
<section class="py-16 bg-gray-50">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="text-sm text-gray-500 mb-2">Get in Touch</p>
    <h1 class="text-4xl font-semibold text-gray-900">Contact</h1>
  </div>
</section>

<%# お問い合わせ案内 %>
<section class="py-12 bg-white">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <p class="text-gray-600 mb-2">
      ご質問・ご相談など、お気軽にお問い合わせください。
    </p>
    <p class="text-gray-500 text-sm">
      通常、3営業日以内にご返信いたします。
    </p>
  </div>
</section>

<%# お問い合わせフォーム %>
<section class="py-12 bg-white">
  <div class="max-w-2xl mx-auto px-6">
    <%# フラッシュメッセージ %>
    <% if flash[:notice] %>
      <div class="mb-8 p-4 bg-green-50 border border-green-200 text-green-700 rounded-lg">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-8 p-4 bg-red-50 border border-red-200 text-red-600 rounded-lg">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% contact = @contact || {} %>
    <div class="bg-white rounded-lg p-8 md:p-10 border border-gray-200">
      <%= form_with url: contact_path, method: :post, local: true, class: "space-y-6" do %>
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
            お名前 <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            value="<%= contact[:name] %>"
            required
            class="form-input"
            placeholder="山田 太郎">
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
            メールアドレス <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= contact[:email] %>"
            required
            class="form-input"
            placeholder="example@email.com">
        </div>

        <div>
          <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
            電話番号
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            value="<%= contact[:phone] %>"
            class="form-input"
            placeholder="03-0000-0000">
        </div>

        <div>
          <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">
            お問い合わせ種別 <span class="text-red-500">*</span>
          </label>
          <select
            id="subject"
            name="subject"
            required
            class="form-input">
            <option value="">選択してください</option>
            <option value="general" <%= "selected" if contact[:subject] == "general" %>>一般的なお問い合わせ</option>
            <option value="service" <%= "selected" if contact[:subject] == "service" %>>サービスについて</option>
            <option value="recruit" <%= "selected" if contact[:subject] == "recruit" %>>採用について</option>
            <option value="other" <%= "selected" if contact[:subject] == "other" %>>その他</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
            お問い合わせ内容 <span class="text-red-500">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            class="form-input resize-none"
            placeholder="お問い合わせ内容をご記入ください"><%= contact[:message] %></textarea>
        </div>

        <div class="text-center pt-4">
          <button type="submit" class="btn-primary">
            送信する
          </button>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# その他の連絡先 %>
<section class="py-20 bg-gray-50">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-sm text-gray-500 mb-2">Other Ways</p>
      <h2 class="text-3xl font-semibold text-gray-900">その他のお問い合わせ方法</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <%# 電話 %>
      <div class="bg-white rounded-lg p-8 border border-gray-200 text-center hover-lift">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">お電話</h3>
        <p class="text-2xl font-medium text-gray-900 mb-4">03-0000-0000</p>
        <p class="text-gray-500 text-sm">
          営業時間: 10:00 - 20:00<br>
          （水曜定休）
        </p>
      </div>

      <%# メール %>
      <div class="bg-white rounded-lg p-8 border border-gray-200 text-center hover-lift">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">メール</h3>
        <p class="text-xl font-medium text-gray-900 mb-4">info@harayan.example.com</p>
        <p class="text-gray-500 text-sm">
          24時間受付<br>
          （返信は営業時間内）
        </p>
      </div>
    </div>
  </div>
</section>
