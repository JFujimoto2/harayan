<% content_for(:title) { "Harayan | 日本茶と光" } %>

<%# ヒーローセクション（フルスクリーン） %>
<section class="relative h-screen min-h-[600px] flex items-center">
  <img src="https://images.unsplash.com/photo-1556679343-c7306c1976bc?w=1920&h=1080&fit=crop"
       alt="日本茶"
       class="absolute inset-0 w-full h-full object-cover">
  <div class="absolute inset-0 bg-black/20"></div>
  <div class="relative z-10 max-w-6xl mx-auto px-6 text-center text-white">
    <h1 class="text-5xl md:text-7xl font-semibold tracking-tight mb-6">Harayan</h1>
    <p class="text-lg md:text-xl font-light opacity-90 mb-8">光をとどける</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to "Stores", stores_path, class: "inline-block px-8 py-3.5 bg-white text-gray-900 text-sm font-medium rounded hover:bg-gray-100 transition-colors" %>
      <%= link_to "About", about_path, class: "inline-block px-8 py-3.5 border border-white text-white text-sm font-medium rounded hover:bg-white hover:text-gray-900 transition-colors" %>
    </div>
  </div>
  <%# スクロールインジケーター %>
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/60">
    <div class="animate-bounce">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<%# コンセプト %>
<section class="py-24 bg-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <p class="text-sm text-gray-500 mb-4">Concept</p>
    <h2 class="text-3xl md:text-4xl font-semibold text-gray-900 mb-8">光</h2>
    <p class="text-gray-600 text-lg leading-relaxed mb-6">
      日本茶の「八十八夜」は、立春から数えて88日目。<br class="hidden md:inline">
      新茶が芽吹き、光が満ちる季節。
    </p>
    <p class="text-gray-500 leading-relaxed">
      私たちは、その光のような体験をお届けするために、<br class="hidden md:inline">
      日本茶を軸とした様々な事業を展開しています。
    </p>
  </div>
</section>

<%# 店舗セクション %>
<section class="py-24 bg-gray-50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-sm text-gray-500 mb-2">Our Brands</p>
      <h2 class="text-3xl font-semibold text-gray-900">Stores</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <%# 八十八 %>
      <%= link_to store_8108_path, class: "group block" do %>
        <div class="relative aspect-[3/4] rounded-lg overflow-hidden">
          <img src="https://images.unsplash.com/photo-1556679343-c7306c1976bc?w=600&h=800&fit=crop"
               alt="八十八"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <p class="text-xs tracking-wider mb-1 opacity-80">Japanese Tea Stand</p>
            <h3 class="text-xl font-semibold">八十八</h3>
          </div>
        </div>
      <% end %>

      <%# A kyoto %>
      <%= link_to store_a_kyoto_path, class: "group block" do %>
        <div class="relative aspect-[3/4] rounded-lg overflow-hidden">
          <img src="https://images.unsplash.com/photo-1579027989536-b7b1f875659b?w=600&h=800&fit=crop"
               alt="A kyoto"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <p class="text-xs tracking-wider mb-1 opacity-80">Japanese Cuisine</p>
            <h3 class="text-xl font-semibold">A kyoto</h3>
          </div>
        </div>
      <% end %>

      <%# B kyoto %>
      <%= link_to store_b_kyoto_path, class: "group block" do %>
        <div class="relative aspect-[3/4] rounded-lg overflow-hidden">
          <img src="https://images.unsplash.com/photo-1470337458703-46ad1756a187?w=600&h=800&fit=crop"
               alt="B kyoto"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <p class="text-xs tracking-wider mb-1 opacity-80">Tea & Craft Gin</p>
            <h3 class="text-xl font-semibold">B kyoto</h3>
          </div>
        </div>
      <% end %>
    </div>

    <div class="text-center mt-12">
      <%= link_to "すべての店舗を見る", stores_path, class: "text-sm font-medium text-gray-900 hover:text-gray-600 link-underline" %>
    </div>
  </div>
</section>

<%# 事業紹介 %>
<section class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-sm text-gray-500 mb-2">What We Do</p>
        <h2 class="text-3xl font-semibold text-gray-900 mb-6">Business</h2>
        <p class="text-gray-600 leading-relaxed mb-6">
          日本茶スタンドの運営をはじめ、卸売事業、レシピ開発、コンサルティングなど、
          日本茶を軸とした幅広い事業を展開しています。
        </p>
        <ul class="text-gray-500 text-sm space-y-2 mb-8">
          <li>・飲食店舗の企画・運営</li>
          <li>・日本茶の卸売事業</li>
          <li>・レシピ開発・コンサルティング</li>
          <li>・オリジナルグッズの企画・販売</li>
        </ul>
        <%= link_to "事業内容を見る", business_path, class: "text-sm font-medium text-gray-900 hover:text-gray-600 link-underline" %>
      </div>
      <div class="aspect-[4/3] rounded-lg overflow-hidden image-container">
        <img src="https://images.unsplash.com/photo-1558160074-4d7d8bdf4256?w=800&h=600&fit=crop"
             alt="事業内容"
             class="w-full h-full object-cover">
      </div>
    </div>
  </div>
</section>

<%# 採用CTA %>
<section class="py-24 bg-gray-50">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <p class="text-sm text-gray-500 mb-2">Join Our Team</p>
    <h2 class="text-3xl font-semibold text-gray-900 mb-6">一緒に働きませんか？</h2>
    <p class="text-gray-600 mb-8">
      私たちと一緒に、日本茶の新しい価値を届けていく仲間を募集しています。
    </p>
    <%= link_to "採用情報を見る", recruit_path, class: "btn-primary" %>
  </div>
</section>

