<% content_for(:title) { "Harayan | トップページ" } %>

<%# ヒーローセクション %>
<section class="relative h-[70vh] min-h-[500px] flex items-center">
  <img src="https://images.unsplash.com/photo-1470337458703-46ad1756a187?w=1920&h=1080&fit=crop"
       alt="バーカウンター"
       class="absolute inset-0 w-full h-full object-cover">
  <div class="absolute inset-0 bg-black/40"></div>
  <div class="relative z-10 max-w-6xl mx-auto px-6 text-center text-white">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight mb-6">Harayan</h1>
    <p class="text-lg md:text-xl font-light opacity-90 mb-8">お客様に最高のふくらはぎをお届けします</p>
    <%= link_to "詳しく見る", about_path, class: "inline-block px-8 py-3.5 bg-white text-gray-900 text-sm font-medium rounded hover:bg-gray-100 transition-colors" %>
  </div>
</section>

<%# About セクション %>
<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-sm text-gray-500 mb-2">About Us</p>
        <h2 class="text-3xl font-semibold text-gray-900 mb-6">私たちについて</h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          「お客様に寄り添う」をコンセプトに、空間・デザイン・サービス・人を大切に、日々の中で感じる特別な時間を創り出しています。
        </p>
        <p class="text-gray-500 text-sm leading-relaxed mb-6">
          心地よい空間と丁寧なサービスで、お客様一人ひとりに寄り添った体験をお届けします。
        </p>
        <%= link_to "会社概要を見る", about_path, class: "text-sm font-medium text-gray-900 hover:text-gray-600 transition-colors link-underline" %>
      </div>
      <div class="aspect-[4/3] rounded-lg overflow-hidden image-container">
        <img src="https://images.unsplash.com/photo-1566417713940-fe7c737a9ef2?w=800&h=600&fit=crop"
             alt="バーテンダー"
             class="w-full h-full object-cover">
      </div>
    </div>
  </div>
</section>

<%# Concept セクション %>
<section class="py-20 bg-gray-50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-sm text-gray-500 mb-2">Our Values</p>
      <h2 class="text-3xl font-semibold text-gray-900">Concept</h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <%# カード1 %>
      <div class="text-center">
        <div class="aspect-square mb-4 rounded-lg overflow-hidden image-container">
          <img src="https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?w=400&h=400&fit=crop"
               alt="ワイン"
               class="w-full h-full object-cover">
        </div>
        <h3 class="text-sm font-semibold text-gray-900 mb-1">Quality</h3>
        <p class="text-xs text-gray-500">品質へのこだわり</p>
      </div>

      <%# カード2 %>
      <div class="text-center">
        <div class="aspect-square mb-4 rounded-lg overflow-hidden image-container">
          <img src="https://images.unsplash.com/photo-1574096079513-d8259312b785?w=400&h=400&fit=crop"
               alt="サービス"
               class="w-full h-full object-cover">
        </div>
        <h3 class="text-sm font-semibold text-gray-900 mb-1">Service</h3>
        <p class="text-xs text-gray-500">心を込めた接客</p>
      </div>

      <%# カード3 %>
      <div class="text-center">
        <div class="aspect-square mb-4 rounded-lg overflow-hidden image-container">
          <img src="https://images.unsplash.com/photo-1572116469696-31de0f17cc34?w=400&h=400&fit=crop"
               alt="空間"
               class="w-full h-full object-cover">
        </div>
        <h3 class="text-sm font-semibold text-gray-900 mb-1">Space</h3>
        <p class="text-xs text-gray-500">居心地の良い空間</p>
      </div>

      <%# カード4 %>
      <div class="text-center">
        <div class="aspect-square mb-4 rounded-lg overflow-hidden image-container">
          <img src="https://images.unsplash.com/photo-1560624052-449f5ddf0c31?w=400&h=400&fit=crop"
               alt="乾杯"
               class="w-full h-full object-cover">
        </div>
        <h3 class="text-sm font-semibold text-gray-900 mb-1">Trust</h3>
        <p class="text-xs text-gray-500">信頼と安心</p>
      </div>
    </div>
  </div>
</section>

<%# Services セクション %>
<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-sm text-gray-500 mb-2">What We Offer</p>
      <h2 class="text-3xl font-semibold text-gray-900">Services</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <%# 店舗 %>
      <%= link_to shops_path, class: "group block" do %>
        <div class="relative rounded-lg overflow-hidden image-container">
          <div class="aspect-[3/2]">
            <img src="https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=800&h=533&fit=crop"
                 alt="店舗"
                 class="w-full h-full object-cover">
          </div>
          <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="text-lg font-semibold mb-1">Shop</h3>
            <p class="text-sm opacity-80">店舗情報</p>
          </div>
        </div>
      <% end %>

      <%# 採用 %>
      <%= link_to recruit_path, class: "group block" do %>
        <div class="relative rounded-lg overflow-hidden image-container">
          <div class="aspect-[3/2]">
            <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=800&h=533&fit=crop"
                 alt="採用"
                 class="w-full h-full object-cover">
          </div>
          <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="text-lg font-semibold mb-1">Recruit</h3>
            <p class="text-sm opacity-80">採用情報</p>
          </div>
        </div>
      <% end %>

      <%# コンタクト %>
      <%= link_to contact_path, class: "group block" do %>
        <div class="relative rounded-lg overflow-hidden image-container">
          <div class="aspect-[3/2]">
            <img src="https://images.unsplash.com/photo-1525268323446-0505b6fe7778?w=800&h=533&fit=crop"
                 alt="コンタクト"
                 class="w-full h-full object-cover">
          </div>
          <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="text-lg font-semibold mb-1">Contact</h3>
            <p class="text-sm opacity-80">お問い合わせ</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# CTA セクション %>
<section class="py-20 bg-gray-900 text-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-2xl md:text-3xl font-semibold mb-4">お気軽にお問い合わせください</h2>
    <p class="text-gray-400 mb-8">
      ご質問やご相談など、お待ちしております
    </p>
    <%= link_to "お問い合わせ", contact_path, class: "inline-block px-8 py-3.5 bg-white text-gray-900 text-sm font-medium rounded hover:bg-gray-100 transition-colors" %>
  </div>
</section>
