<% content_for(:title) { "Harayan | トップページ" } %>

<%# ヒーローセクション %>
<section class="relative h-screen min-h-[600px] flex items-center justify-center -mt-20">
  <%# 背景画像（ダミー：グラデーション） %>
  <div class="absolute inset-0 bg-gradient-to-br from-primary-600 via-primary-500 to-primary-700"></div>
  <div class="absolute inset-0 bg-black/30"></div>

  <%# コンテンツ %>
  <div class="relative z-10 text-center text-white px-4">
    <h1 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-wider mb-6">
      Harayan
    </h1>
    <p class="text-lg md:text-xl font-light mb-8 max-w-2xl mx-auto leading-relaxed">
      お客様に最高の体験をお届けします
    </p>
    <%= link_to "詳しく見る", about_path,
        class: "inline-block px-8 py-4 border border-white text-white
               hover:bg-white hover:text-gray-900 transition-all duration-300" %>
  </div>

  <%# スクロールインジケーター %>
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>

<%# コンセプトセクション %>
<section class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-light tracking-wide text-gray-900 mb-8">
      Concept
    </h2>
    <p class="text-lg text-gray-600 leading-relaxed mb-6">
      私たちは、日常に特別な時間を創り出すことを大切にしています。
    </p>
    <p class="text-gray-500 leading-relaxed">
      心地よい空間と丁寧なサービスで、<br class="hidden md:inline">
      お客様一人ひとりに寄り添った体験をお届けします。
    </p>
  </div>
</section>

<%# サービス紹介セクション %>
<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-light tracking-wide text-gray-900 mb-4">
        Services
      </h2>
      <p class="text-gray-600">
        私たちが提供するサービス
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <%# カード1: 店舗 %>
      <%= link_to shops_path, class: "group block" do %>
        <div class="bg-white overflow-hidden hover:shadow-lg transition-shadow duration-300">
          <div class="aspect-[4/3] bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center">
            <span class="text-white text-6xl font-light">01</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-medium text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
              Shop
            </h3>
            <p class="text-gray-500 text-sm">
              店舗情報をご覧いただけます
            </p>
          </div>
        </div>
      <% end %>

      <%# カード2: 採用 %>
      <%= link_to recruit_path, class: "group block" do %>
        <div class="bg-white overflow-hidden hover:shadow-lg transition-shadow duration-300">
          <div class="aspect-[4/3] bg-gradient-to-br from-accent-400 to-accent-600 flex items-center justify-center">
            <span class="text-white text-6xl font-light">02</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-medium text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
              Recruit
            </h3>
            <p class="text-gray-500 text-sm">
              一緒に働く仲間を募集しています
            </p>
          </div>
        </div>
      <% end %>

      <%# カード3: コンタクト %>
      <%= link_to contact_path, class: "group block" do %>
        <div class="bg-white overflow-hidden hover:shadow-lg transition-shadow duration-300">
          <div class="aspect-[4/3] bg-gradient-to-br from-gray-600 to-gray-800 flex items-center justify-center">
            <span class="text-white text-6xl font-light">03</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-medium text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
              Contact
            </h3>
            <p class="text-gray-500 text-sm">
              お問い合わせはこちらから
            </p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# CTAセクション %>
<section class="py-20 bg-primary-600">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl md:text-3xl font-light text-white mb-6">
      お気軽にお問い合わせください
    </h2>
    <p class="text-primary-100 mb-8">
      ご質問やご相談など、お待ちしております
    </p>
    <%= link_to "お問い合わせ", contact_path,
        class: "inline-block px-8 py-4 bg-white text-primary-600 font-medium
               hover:bg-gray-100 transition-colors" %>
  </div>
</section>
