<%# お問い合わせCTA %>
<section class="py-20 bg-gray-900 text-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-2xl md:text-3xl font-semibold mb-4">お問い合わせ</h2>
    <p class="text-gray-400 mb-8">
      ご質問・ご相談など、お気軽にお問い合わせください
    </p>
    <%= link_to "Contact", contact_path, class: "inline-block px-8 py-3.5 bg-white text-gray-900 text-sm font-medium rounded hover:bg-gray-100 transition-colors" %>
  </div>
</section>
