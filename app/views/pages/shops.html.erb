<% content_for(:title) { "Shops | Harayan" } %>

<%# ページヘッダー %>
<section class="py-16 bg-gray-50">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="text-sm text-gray-500 mb-2">Location</p>
    <h1 class="text-4xl font-semibold text-gray-900">Shops</h1>
  </div>
</section>

<%# 店舗一覧セクション %>
<section class="py-20 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <%# 店舗画像 %>
      <div class="aspect-[4/3] rounded-lg overflow-hidden bg-gray-100 flex items-center justify-center">
        <span class="text-gray-400 text-2xl">Shop Image</span>
      </div>

      <%# 店舗情報 %>
      <div>
        <p class="text-sm text-gray-500 mb-2">Main Store</p>
        <h2 class="text-2xl font-semibold text-gray-900 mb-6">Harayan 本店</h2>

        <div class="space-y-4 mb-8">
          <div class="flex">
            <span class="w-24 text-gray-500 text-sm shrink-0">住所</span>
            <span class="text-gray-900">
              〒000-0000<br>
              東京都○○区○○ 1-2-3
            </span>
          </div>
          <div class="flex">
            <span class="w-24 text-gray-500 text-sm shrink-0">電話</span>
            <span class="text-gray-900">03-0000-0000</span>
          </div>
          <div class="flex">
            <span class="w-24 text-gray-500 text-sm shrink-0">営業時間</span>
            <span class="text-gray-900">10:00 - 20:00</span>
          </div>
          <div class="flex">
            <span class="w-24 text-gray-500 text-sm shrink-0">定休日</span>
            <span class="text-gray-900">水曜日</span>
          </div>
        </div>

        <%# アクセス %>
        <div class="mb-8">
          <h3 class="text-lg font-semibold text-gray-900 mb-3">Access</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            ○○駅から徒歩5分<br>
            △△バス停から徒歩2分
          </p>
        </div>

        <%= link_to "お問い合わせ", contact_path, class: "btn-primary" %>
      </div>
    </div>
  </div>
</section>

<%# 地図セクション %>
<section class="py-20 bg-gray-50">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-10">
      <p class="text-sm text-gray-500 mb-2">Location</p>
      <h2 class="text-2xl font-semibold text-gray-900">Map</h2>
    </div>
    <div class="aspect-[16/9] w-full rounded-lg overflow-hidden border border-gray-200">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3240.8280303808788!2d139.76493807618522!3d35.68124012997957!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60188bfbd89f700b%3A0x277c49ba34ed38!2z5p2x5Lqs6aeF!5e0!3m2!1sja!2sjp!4v1704931200000!5m2!1sja!2sjp"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="w-full h-full">
      </iframe>
    </div>
    <p class="text-center text-gray-400 text-sm mt-4">
      ※ 上記は仮の位置（東京駅）です。実際の店舗住所に変更してください。
    </p>
  </div>
</section>
