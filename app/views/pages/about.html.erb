<% content_for(:title) { "About | Harayan" } %>

<%# ヒーローセクション %>
<section class="relative h-[50vh] min-h-[400px] flex items-center">
  <img src="https://images.unsplash.com/photo-1558160074-4d7d8bdf4256?w=1920&h=1080&fit=crop"
       alt="About Harayan"
       class="absolute inset-0 w-full h-full object-cover">
  <div class="absolute inset-0 bg-black/30"></div>
  <div class="relative z-10 max-w-6xl mx-auto px-6 text-center text-white">
    <p class="text-sm tracking-wider mb-4 opacity-80">About Us</p>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">About</h1>
  </div>
</section>

<%# 理念セクション %>
<section class="py-24 bg-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <p class="text-sm text-gray-500 mb-4">Our Philosophy</p>
    <h2 class="text-3xl md:text-4xl font-semibold text-gray-900 mb-8">光</h2>
    <p class="text-gray-600 text-lg leading-relaxed mb-6">
      「八十八夜」は、立春から数えて88日目。<br>
      新茶が芽吹き、光が満ちる季節です。
    </p>
    <p class="text-gray-500 leading-relaxed">
      私たちは、その光のような体験をお届けするために、<br class="hidden md:inline">
      日本茶を軸とした様々な事業を展開しています。<br class="hidden md:inline">
      伝統を大切にしながら、新しい価値を創造し続けます。
    </p>
  </div>
</section>

<%# ミッション・ビジョン・バリュー %>
<section class="py-24 bg-gray-50">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <%# Mission %>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-white border border-gray-200 flex items-center justify-center">
          <span class="text-gray-900 text-xl font-semibold">M</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Mission</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          日本茶を通じて、<br>
          人々の日常に光を届ける
        </p>
      </div>

      <%# Vision %>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-white border border-gray-200 flex items-center justify-center">
          <span class="text-gray-900 text-xl font-semibold">V</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Vision</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          世界中の人々に<br>
          日本茶の魅力を届ける
        </p>
      </div>

      <%# Value %>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-white border border-gray-200 flex items-center justify-center">
          <span class="text-gray-900 text-xl font-semibold">V</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Value</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          伝統と革新<br>
          誠実さと挑戦
        </p>
      </div>
    </div>
  </div>
</section>

<%# 会社概要 %>
<section class="py-24 bg-white">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-sm text-gray-500 mb-2">Information</p>
      <h2 class="text-3xl font-semibold text-gray-900">Company</h2>
    </div>

    <div class="bg-gray-50 rounded-lg p-8 md:p-10">
      <table class="w-full">
        <tbody>
          <tr class="border-b border-gray-200">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium w-1/3 align-top">会社名</th>
            <td class="py-4 text-gray-900">株式会社Harayan（仮）</td>
          </tr>
          <tr class="border-b border-gray-200">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">設立</th>
            <td class="py-4 text-gray-900">2024年</td>
          </tr>
          <tr class="border-b border-gray-200">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">代表者</th>
            <td class="py-4 text-gray-900">代表取締役 ○○ ○○</td>
          </tr>
          <tr class="border-b border-gray-200">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">所在地</th>
            <td class="py-4 text-gray-900">
              〒000-0000<br>
              東京都○○区○○ X-X-X
            </td>
          </tr>
          <tr class="border-b border-gray-200">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">事業内容</th>
            <td class="py-4 text-gray-900">
              ・日本茶スタンドの企画・運営<br>
              ・和食・鉄板料理レストランの企画・運営<br>
              ・カフェバーの企画・運営<br>
              ・日本茶の卸売事業<br>
              ・レシピ開発・コンサルティング<br>
              ・オリジナルグッズの企画・販売
            </td>
          </tr>
          <tr>
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">店舗</th>
            <td class="py-4 text-gray-900">
              八十八（浅草・渋谷・鎌倉）<br>
              A kyoto（京都・祇園四条）<br>
              B kyoto（京都・祇園四条）
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%# 事業紹介への導線 %>
<section class="py-16 bg-gray-50">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <p class="text-gray-600 mb-6">
      事業内容の詳細はこちら
    </p>
    <%= link_to "事業内容を見る", business_path, class: "btn-primary" %>
  </div>
</section>

<%# CTAセクション %>
<section class="py-16 bg-gray-900 text-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-2xl md:text-3xl font-semibold mb-4">お問い合わせ</h2>
    <p class="text-gray-400 mb-8">
      ご不明な点がございましたら、お気軽にお問い合わせください
    </p>
    <%= link_to "Contact", contact_path, class: "inline-block px-8 py-3.5 bg-white text-gray-900 text-sm font-medium rounded hover:bg-gray-100 transition-colors" %>
  </div>
</section>
