<% content_for(:title) { "About | Harayan" } %>

<%# ページヘッダー %>
<section class="py-16 bg-gray-50">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="text-sm text-gray-500 mb-2">Company</p>
    <h1 class="text-4xl font-semibold text-gray-900">About</h1>
  </div>
</section>

<%# 理念セクション %>
<section class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-sm text-gray-500 mb-2">Our Philosophy</p>
      <h2 class="text-3xl font-semibold text-gray-900 mb-8">Philosophy</h2>
      <p class="text-lg text-gray-600 leading-relaxed">
        私たちは「お客様に最高のふくらはぎを」という理念のもと、<br class="hidden md:inline">
        日々サービスの向上に努めています。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <%# Mission %>
      <div class="text-center p-6">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
          <span class="text-gray-900 text-2xl font-semibold">M</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Mission</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          お客様の期待を超える<br>ふくらはぎを提供する
        </p>
      </div>

      <%# Vision %>
      <div class="text-center p-6">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
          <span class="text-gray-900 text-2xl font-semibold">V</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Vision</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          地域で最も愛される<br>ふくらはぎを目指す
        </p>
      </div>

      <%# Value %>
      <div class="text-center p-6">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
          <span class="text-gray-900 text-2xl font-semibold">V</span>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Value</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          誠実・挑戦・感謝の<br>心を大切にする
        </p>
      </div>
    </div>
  </div>
</section>

<%# 会社概要セクション %>
<section class="py-20 bg-gray-50">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-sm text-gray-500 mb-2">Information</p>
      <h2 class="text-3xl font-semibold text-gray-900">Company</h2>
    </div>

    <div class="bg-white rounded-lg p-8 md:p-10 border border-gray-200">
      <table class="w-full">
        <tbody>
          <tr class="border-b border-gray-100">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium w-1/3 align-top">会社名</th>
            <td class="py-4 text-gray-900">株式会社Harayan</td>
          </tr>
          <tr class="border-b border-gray-100">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">設立</th>
            <td class="py-4 text-gray-900">2024年1月</td>
          </tr>
          <tr class="border-b border-gray-100">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">代表者</th>
            <td class="py-4 text-gray-900">代表取締役 山田 太郎</td>
          </tr>
          <tr class="border-b border-gray-100">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">所在地</th>
            <td class="py-4 text-gray-900">
              〒000-0000<br>
              東京都○○区○○ 1-2-3
            </td>
          </tr>
          <tr class="border-b border-gray-100">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">電話番号</th>
            <td class="py-4 text-gray-900">03-0000-0000</td>
          </tr>
          <tr>
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">事業内容</th>
            <td class="py-4 text-gray-900">
              ・サービス事業<br>
              ・その他関連ふくらはぎ事業
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%# CTAセクション %>
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <p class="text-gray-600 mb-6">
      ご不明な点がございましたら、お気軽にお問い合わせください
    </p>
    <%= link_to "お問い合わせ", contact_path, class: "btn-primary" %>
  </div>
</section>
