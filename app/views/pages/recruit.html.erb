<% content_for(:title) { "Recruit | Harayan" } %>

<%# ヒーローセクション %>
<section class="relative h-[50vh] min-h-[400px] flex items-center">
  <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1920&h=1080&fit=crop"
       alt="Recruit"
       class="absolute inset-0 w-full h-full object-cover">
  <div class="absolute inset-0 bg-black/30"></div>
  <div class="relative z-10 max-w-6xl mx-auto px-6 text-center text-white">
    <p class="text-sm tracking-wider mb-4 opacity-80">Join Our Team</p>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">Recruit</h1>
  </div>
</section>

<%# メッセージセクション %>
<section class="py-24 bg-white">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <h2 class="text-3xl font-semibold text-gray-900 mb-8">一緒に、光を届けませんか？</h2>
    <p class="text-gray-600 leading-relaxed mb-6 text-lg">
      私たちは、日本茶を通じて人々の日常に光を届けています。<br class="hidden md:inline">
      その想いに共感し、一緒に成長できる仲間を募集しています。
    </p>
    <p class="text-gray-500 text-sm">
      未経験の方も歓迎。充実した研修制度でサポートします。
    </p>
  </div>
</section>

<%# 働く魅力 %>
<section class="py-24 bg-gray-50">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-sm text-gray-500 mb-2">Why Join Us</p>
      <h2 class="text-3xl font-semibold text-gray-900">働く魅力</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white rounded-lg p-8 text-center">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-gray-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-3">成長できる環境</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          日本茶の知識から接客スキルまで、<br>
          幅広く学べる研修制度があります
        </p>
      </div>

      <div class="bg-white rounded-lg p-8 text-center">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-gray-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-3">魅力的なロケーション</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          浅草・渋谷・鎌倉・京都など、<br>
          人気の観光地で働けます
        </p>
      </div>

      <div class="bg-white rounded-lg p-8 text-center">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-gray-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-3">チームワーク</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          20代〜30代が中心の<br>
          活気あるチームです
        </p>
      </div>
    </div>
  </div>
</section>

<%# 募集要項 %>
<section class="py-24 bg-white">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-sm text-gray-500 mb-2">Job Details</p>
      <h2 class="text-3xl font-semibold text-gray-900">募集要項</h2>
    </div>

    <div class="bg-gray-50 rounded-lg p-8 md:p-10">
      <table class="w-full">
        <tbody>
          <tr class="border-b border-gray-200">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium w-1/3 align-top">募集職種</th>
            <td class="py-4 text-gray-900">店舗スタッフ（正社員・アルバイト）</td>
          </tr>
          <tr class="border-b border-gray-200">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">仕事内容</th>
            <td class="py-4 text-gray-900">
              ・接客業務<br>
              ・ドリンク・フードの提供<br>
              ・店舗運営補助
            </td>
          </tr>
          <tr class="border-b border-gray-200">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">応募資格</th>
            <td class="py-4 text-gray-900">
              ・18歳以上（高校生不可）<br>
              ・未経験者歓迎
            </td>
          </tr>
          <tr class="border-b border-gray-200">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">勤務地</th>
            <td class="py-4 text-gray-900">
              八十八（浅草・渋谷・鎌倉）<br>
              A kyoto / B kyoto（京都・祇園四条）
            </td>
          </tr>
          <tr class="border-b border-gray-200">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">勤務時間</th>
            <td class="py-4 text-gray-900">
              シフト制（店舗により異なる）<br>
              <span class="text-gray-500 text-sm">※週3日〜、1日4時間〜応相談</span>
            </td>
          </tr>
          <tr class="border-b border-gray-200">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">給与</th>
            <td class="py-4 text-gray-900">
              正社員：月給 220,000円〜<br>
              アルバイト：時給 1,200円〜<br>
              <span class="text-gray-500 text-sm">※経験・能力により優遇</span>
            </td>
          </tr>
          <tr>
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">待遇</th>
            <td class="py-4 text-gray-900">
              ・交通費支給（規定あり）<br>
              ・社会保険完備（正社員）<br>
              ・制服貸与<br>
              ・研修制度あり<br>
              ・従業員割引あり
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%# 応募方法 %>
<section class="py-16 bg-gray-900 text-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-2xl md:text-3xl font-semibold mb-4">ご応募お待ちしています</h2>
    <p class="text-gray-400 mb-4">
      下記のお問い合わせフォームより、ご応募ください。
    </p>
    <p class="text-gray-500 text-sm mb-8">
      担当者より3営業日以内にご連絡いたします。
    </p>
    <%= link_to "応募する", contact_path, class: "inline-block px-8 py-3.5 bg-white text-gray-900 text-sm font-medium rounded hover:bg-gray-100 transition-colors" %>
  </div>
</section>
