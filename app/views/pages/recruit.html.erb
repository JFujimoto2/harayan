<% content_for(:title) { "Recruit | Harayan" } %>

<%# ページヘッダー %>
<section class="py-16 bg-gray-50">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <p class="text-sm text-gray-500 mb-2">Career</p>
    <h1 class="text-4xl font-semibold text-gray-900">Recruit</h1>
  </div>
</section>

<%# メッセージセクション %>
<section class="py-20 bg-white">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <p class="text-sm text-gray-500 mb-2">Join Our Team</p>
    <h2 class="text-3xl font-semibold text-gray-900 mb-8">一緒に働きませんか？</h2>
    <p class="text-gray-600 leading-relaxed mb-4 text-lg">
      私たちは、お客様に最高の体験を届けるために、<br class="hidden md:inline">
      情熱を持って働ける仲間を募集しています。
    </p>
    <p class="text-gray-500 text-sm">
      未経験者歓迎。充実した研修制度でサポートします。
    </p>
  </div>
</section>

<%# 求める人物像 %>
<section class="py-20 bg-gray-50">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-sm text-gray-500 mb-2">Who We're Looking For</p>
      <h2 class="text-3xl font-semibold text-gray-900">求める人物像</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="text-center p-6">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">人と接することが好きな方</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          お客様との対話を楽しめる方を歓迎します
        </p>
      </div>

      <div class="text-center p-6">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">向上心のある方</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          常に成長を目指す姿勢を大切にしています
        </p>
      </div>

      <div class="text-center p-6">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">チームワークを大切にする方</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          仲間と協力して目標を達成できる方
        </p>
      </div>
    </div>
  </div>
</section>

<%# 募集要項 %>
<section class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="text-sm text-gray-500 mb-2">Job Details</p>
      <h2 class="text-3xl font-semibold text-gray-900">募集要項</h2>
    </div>

    <div class="bg-white rounded-lg p-8 md:p-10 border border-gray-200">
      <table class="w-full">
        <tbody>
          <tr class="border-b border-gray-100">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium w-1/3 align-top">募集職種</th>
            <td class="py-4 text-gray-900">スタッフ（正社員・アルバイト）</td>
          </tr>
          <tr class="border-b border-gray-100">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">仕事内容</th>
            <td class="py-4 text-gray-900">
              ・接客業務<br>
              ・店舗運営補助<br>
              ・その他付随業務
            </td>
          </tr>
          <tr class="border-b border-gray-100">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">応募資格</th>
            <td class="py-4 text-gray-900">
              ・18歳以上（高校生不可）<br>
              ・未経験者歓迎
            </td>
          </tr>
          <tr class="border-b border-gray-100">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">勤務地</th>
            <td class="py-4 text-gray-900">Harayan 本店（東京都○○区）</td>
          </tr>
          <tr class="border-b border-gray-100">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">勤務時間</th>
            <td class="py-4 text-gray-900">
              9:00〜21:00（シフト制）<br>
              <span class="text-gray-500 text-sm">※週3日〜、1日4時間〜応相談</span>
            </td>
          </tr>
          <tr class="border-b border-gray-100">
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">給与</th>
            <td class="py-4 text-gray-900">
              正社員：月給 220,000円〜<br>
              アルバイト：時給 1,200円〜<br>
              <span class="text-gray-500 text-sm">※経験・能力により優遇</span>
            </td>
          </tr>
          <tr>
            <th class="py-4 pr-4 text-left text-gray-500 text-sm font-medium align-top">待遇・福利厚生</th>
            <td class="py-4 text-gray-900">
              ・交通費支給（規定あり）<br>
              ・社会保険完備（正社員）<br>
              ・制服貸与<br>
              ・研修制度あり
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%# 応募方法 %>
<section class="py-16 bg-gray-900 text-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-2xl md:text-3xl font-semibold mb-4">応募方法</h2>
    <p class="text-gray-300 mb-4">
      下記のお問い合わせフォームより、ご応募ください。
    </p>
    <p class="text-gray-400 text-sm mb-8">
      担当者より3営業日以内にご連絡いたします。
    </p>
    <%= link_to "応募する", contact_path, class: "inline-block px-8 py-3.5 bg-white text-gray-900 text-sm font-medium rounded hover:bg-gray-100 transition-colors" %>
  </div>
</section>
